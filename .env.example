# SOC Shift Manager - Environment Variables Configuration
# Copy this file to .env and customize the values

# =============================================================================
# ADMIN USER CONFIGURATION
# =============================================================================
# Default admin account created on first startup
# ⚠️ IMPORTANT: Change these values in production!

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@soc.local

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================
# Environment: development, production, testing
FLASK_ENV=production

# Secret keys for session management and JWT tokens
# ⚠️ CRITICAL: Generate unique secret keys for production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-in-production

# JWT Token expiration times (in hours/days)
# JWT_ACCESS_TOKEN_EXPIRES=1  # hours
# JWT_REFRESH_TOKEN_EXPIRES=30  # days

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Default: SQLite (file-based, suitable for small deployments)
# For production: Consider PostgreSQL

# SQLite (default - no configuration needed)
# DATABASE_URL=sqlite:///instance/soc_shift_manager.db

# PostgreSQL (uncomment and configure for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/soc_shift_manager

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for API requests
# Default: Allow localhost for development
# Production: Set to your frontend URL

# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Application timezone (for shift calculations)
# TIMEZONE=Europe/Athens

# Default language
# LANGUAGE=en

# Enable debug mode (⚠️ Never enable in production!)
# DEBUG=False

# =============================================================================
# FRONTEND CONFIGURATION (React)
# =============================================================================
# API base URL - Frontend uses this to connect to backend
# REACT_APP_API_URL=http://localhost:5000/api

# Enable React dev tools
# REACT_APP_DEBUG=false

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================
# Port mappings
# BACKEND_PORT=5000
# FRONTEND_PORT=3000

# Restart policy
# RESTART_POLICY=unless-stopped

# =============================================================================
# SAMPLE DATA (First-Time Setup Only)
# =============================================================================
# Whether to create sample data on first run
# INITIALIZE_SAMPLE_DATA=true

# Number of sample shifts to generate
# SAMPLE_SHIFTS_COUNT=60

# Sample data date range (days)
# SAMPLE_DATA_DAYS=90

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Log file path
# LOG_FILE=/app/logs/application.log

# =============================================================================
# SECURITY SETTINGS (Production)
# =============================================================================
# Force HTTPS redirects
# FORCE_HTTPS=false

# Session cookie security
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax

# Password policy
# MIN_PASSWORD_LENGTH=8
# REQUIRE_SPECIAL_CHARS=true
# REQUIRE_NUMBERS=true
# REQUIRE_UPPERCASE=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Automatic database backups
# ENABLE_AUTO_BACKUP=false
# BACKUP_SCHEDULE=daily
# BACKUP_RETENTION_DAYS=30
# BACKUP_PATH=/app/backups

# =============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# =============================================================================
# SMTP settings for email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@soc.local

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the values as needed
# 3. Keep .env file private (it's in .gitignore)
# 4. Generate secure random keys for SECRET_KEY and JWT_SECRET_KEY
# 5. Change default admin credentials before deployment
# 
# For more information, see README.md and QUICKSTART.md
